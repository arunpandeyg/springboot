<?xml version="1.0" encoding="UTF-8"?>
<beans
        xmlns="http://www.springframework.org/schema/beans"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:context="http://www.springframework.org/schema/context"
        xsi:schemaLocation="
        http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-3.1.xsd
        http://www.springframework.org/schema/context
        http://www.springframework.org/schema/context/spring-context.xsd" >

    <!--it's 1st bean constructor injection -->
    <context:annotation-config />

    <bean class="com.springcore.annotation.Address" name="address" >
          <property name="street" value="s1" />
          <property name="city" value="Delhi" />
    </bean>

    <bean class="com.springcore.annotation.Address" name="address1" >
        <property name="street1" value="s2" />
        <property name="city1" value="New Delhi" />
    </bean>

       <bean class="com.springcore.annotation.Emp" name="emp1" />



 </beans>




